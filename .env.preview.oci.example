# MAKSR Preview only. Example names only. Never commit real secrets.
# Selected sovereign provider: Oracle Cloud Infrastructure, Saudi Arabia West (Jeddah).

# PostgreSQL
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=5
DATABASE_CA_CERT_PATH=

# OpenID Connect through Oracle Cloud Infrastructure Identity and Access Management Identity Domain
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_ALLOWED_ALGORITHMS=RS256,PS256,ES256
OIDC_SCOPES=openid profile email
OIDC_CLOCK_SKEW_SECONDS=60

# Session
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=3600

# Environment evidence
MAKSR_ENVIRONMENT=preview
MAKSR_DATA_REGION=me-jeddah-1
MAKSR_DATABASE_PROVIDER=oracle-cloud-infrastructure-database-with-postgresql
MAKSR_IDENTITY_PROVIDER=oracle-cloud-infrastructure-identity-domain

# One-time institutional bootstrap. Operator environment only.
BOOTSTRAP_ORGANIZATION_ID=
BOOTSTRAP_LEGAL_NAME=
BOOTSTRAP_DISPLAY_NAME=
BOOTSTRAP_OIDC_ISSUER=
BOOTSTRAP_OIDC_SUBJECT=
BOOTSTRAP_IDENTITY_DISPLAY_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_EMAIL_VERIFIED=false

# Example names only. Never commit real secrets.

# PostgreSQL runtime provider.
# url = generic PostgreSQL connection string
# gcp-cloud-sql = Google Cloud SQL in the sovereign Saudi profile
DATABASE_PROVIDER=url
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=5
DATABASE_EXPECTED_REGION=
DATABASE_RESIDENCY_COUNTRY=

# Sovereign Google Cloud SQL profile for Dammam, Kingdom of Saudi Arabia.
# Set DATABASE_PROVIDER=gcp-cloud-sql when this profile is active.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_DATABASE=
CLOUD_SQL_IAM_DATABASE_USER=
CLOUD_SQL_EXPECTED_REGION=me-central2
DATABASE_RESIDENCY_COUNTRY=SA

# Vercel OpenID Connect federation into Google Cloud Workload Identity Federation.
# These values are identifiers, not private keys.
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Institutional OpenID Connect identity provider for MAKSR users.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_ALGORITHMS=RS256,PS256,ES256
OIDC_SCOPES=openid profile email
OIDC_CLOCK_SKEW_SECONDS=60

SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=3600

# One-time operator bootstrap inputs. Use only from a controlled operator environment.
BOOTSTRAP_ORGANIZATION_ID=
BOOTSTRAP_LEGAL_NAME=
BOOTSTRAP_DISPLAY_NAME=
BOOTSTRAP_OIDC_ISSUER=
BOOTSTRAP_OIDC_SUBJECT=
BOOTSTRAP_IDENTITY_DISPLAY_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_EMAIL_VERIFIED=false
